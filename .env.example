# ─── Phaya API · image + video generation ───────────────────
# Get key from https://phaya.io/dashboard
PHAYA_API_KEY=pk_your_phaya_key_here

# Reference image URL for i2i mode (must be public · JPEG/PNG/WEBP · ≤30MB)
# Easy options:
#   - GitHub raw: https://raw.githubusercontent.com/biigket/clarity-mkt-content/main/ads/assets/v3-diagram.png
#   - Imgur: https://i.imgur.com/xxxxx.png (use scripts/upload-to-imgur.sh)
REFERENCE_URL=https://raw.githubusercontent.com/biigket/clarity-mkt-content/main/ads/assets/v3-diagram.png

# ─── Optional · TTS for sound-on video variants ──────────────
# ElevenLabs (Thai voices · best quality)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ─── Optional · Image hosting helper ─────────────────────────
# Imgur Client ID (anonymous upload · no user auth needed)
# Get free at: https://api.imgur.com/oauth2/addclient
# Select "Anonymous usage without user authorization"
IMGUR_CLIENT_ID=

# ─── Optional · OpenAI fallback ──────────────────────────────
# For testing prompts directly against gpt-image-1 / dall-e-3
OPENAI_API_KEY=

# ─── Optional · Google Sheets MCP ────────────────────────────
# Already configured · see .mcp.json + .claude/hooks/setup-google-creds.sh
# GOOGLE_CREDENTIALS_B64=

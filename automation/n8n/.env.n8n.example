# ─── n8n editor UI ───────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong

# ─── Notion (destination · "โต๊ะกลาง") ───────────────────────

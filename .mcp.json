{
  "mcpServers": {
    "google-sheets": {
      "command": "uvx",
      "args": ["mcp-google-sheets@latest"],
      "env": {
        "SERVICE_ACCOUNT_PATH": "${SERVICE_ACCOUNT_PATH:-./.secrets/google-service-account.json}",
        "CREDENTIALS_CONFIG": "${GOOGLE_SHEETS_CREDENTIALS_BASE64:-}",
        "DRIVE_FOLDER_ID": "${GOOGLE_SHEETS_DRIVE_FOLDER_ID:-}"
      }
    }
  }
}
